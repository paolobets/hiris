#!/bin/sh
# HIRIS — due cancelli in un solo hook.
#
# 1. Il linter (ruff + oxlint) gira su OGNI push, senza eccezioni: costa
#    frazioni di secondo su tutto il repo, e non dorme mai.
# 2. La verifica dei componenti si sveglia SOLO se il push contiene un cambio
#    del campo `version` di hiris/config.yaml: riconosce il rilascio dal
#    CONTENUTO, non dalle intenzioni, non da un flag e non dal nome del ramo.
#    Questo blocco si', dorme sui push ordinari -- e deve dormire davvero: un
#    cancello che blocca sempre e' un cancello che verra' disattivato, e
#    allora non protegge piu' niente. Il linter non corre questo rischio:
#    costa troppo poco perche' qualcuno lo disattivi.
#
# NON FA DOMANDE. Durante pre-push git usa lo stdin per passare i ref, e i push
# di questo progetto partono anche da una sessione senza terminale: un prompt
# resterebbe appeso per sempre. Si ferma, stampa, e dice come si risponde.
#
# NON legge HIRIS_COMPONENTI_OK: la regola di sblocco vive in un posto solo
# (`risposta_accettata`, in Python). Scriverla anche qui sarebbe la stessa
# regola in due linguaggi, libera di divergere. Qui si decide UNA cosa sola:
# se questo push e' un rilascio.
#
# Attivazione (una volta per clone):  git config core.hooksPath .githooks
#
# Spec: docs/design/2026-08-15-verifica-dei-componenti.md
#       docs/design/2026-08-27-il-linter-e-le-best-practice.md

# I bersagli sono NOMINATI, mai `.`: `Testbook/`, `Nuova grafica/` e
# `.mockups/` esistono in locale e non sul CI, e un cancello che guarda cose
# diverse nei due posti non e' un cancello.
#
# M-4 (review finale «il linter e le best practice»): un clone senza
# `pip install -r hiris/requirements.txt` non ha ruff, e riceveva lo stesso
# messaggio di un push con rilievi veri («si sanano, non si aggirano») --
# falso, perche' il linter non e' nemmeno girato. Si distingue PRIMA di
# lanciarlo, cosi' il messaggio nomina la causa vera.
#
# A differenza di oxlint (sotto), qui si resta FAIL-CLOSED anche quando
# manca lo strumento: Python e' il cuore del prodotto (89.453 righe contro
# il frontend), e il CI lo ricontrolla comunque -- ma un push locale da un
# clone non attrezzato e' meglio fermarlo con un'istruzione chiara che
# lasciarlo passare senza che nessuno l'abbia mai controllato.
if ! python -c "import ruff" >/dev/null 2>&1; then
    echo "HIRIS: ruff non e' installato in questo Python -- il linter non e' girato."
    echo "       Per installarlo:  pip install -r hiris/requirements.txt"
    exit 1
fi

python -m ruff check hiris scripts tests conftest.py .smoke-test || {
    echo "HIRIS: il linter ha trovato dei rilievi. Si sanano, non si aggirano."
    echo "       Per vederli:  python -m ruff check hiris scripts tests conftest.py .smoke-test"
    exit 1
}

# Un clone senza `npm install` non ha oxlint: non lo si blocca per uno
# strumento che non ha. Il CI e' il cancello vero su questo strato, questo e'
# la comodita' veloce.
if [ -d node_modules ]; then
    npm run --silent lint || {
        echo "HIRIS: oxlint ha trovato dei rilievi nel frontend."
        echo "       Per vederli:  npm run lint"
        exit 1
    }
fi

VUOTO=0000000000000000000000000000000000000000

while read -r _locale sha_locale _remoto sha_remoto; do
    # Cancellazione di un ramo: niente da verificare.
    [ "$sha_locale" = "$VUOTO" ] && continue

    if [ "$sha_remoto" = "$VUOTO" ]; then
        # Ramo nuovo sul remoto: si guarda il solo commit in punta invece di
        # tutta la storia, che conterrebbe ogni bump mai fatto.
        intervallo="$sha_locale~1..$sha_locale"
    else
        intervallo="$sha_remoto..$sha_locale"
    fi

    if git diff "$intervallo" -- hiris/config.yaml 2>/dev/null | grep -q '^[+-]version:'; then
        python scripts/verifica_componenti.py || exit 1
    fi
done

exit 0
