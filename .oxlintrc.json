{
  // HIRIS -- il cancello sugli identificatori del frontend.
  //
  // `hiris/app/static/` non ha moduli: 28 file caricati con `<script src>` in
  // ordine fisso (contati nei due `.html` il 18/09/2026, non ricopiati: erano
  // 23 prima che la pagina dell'osservatore diventasse sei file), che si
  // parlano per variabile globale. Senza questa
  // configurazione `no-undef` e' spento e una mezza rinomina passa muta.
  // Misurato: `var lastResolvedHash` rinominato nella dichiarazione e in 2 usi
  // su 4 lascia due assegnamenti orfani che in JS non-strict CREANO UNA
  // GLOBALE IMPLICITA invece di fallire -- `npm run lint` di prima usciva 0,
  // zero righe. E' la classe di `server.py` del 1 settembre, in JavaScript.
  //
  // COSA QUESTO CANCELLO NON COPRE, ed e' per costruzione.
  // La specie fra file: una funzione dichiarata in un file e usata in un altro
  // senza import. `no-undef` lavora un file per volta, quindi per restare
  // verde su un albero sano gli si deve DICHIARARE che `HirisRouter` e
  // `fmtNum` esistono -- e quella dichiarazione e' esattamente cio' che lo
  // acceca il giorno in cui qualcuno rinomina chi li produce. Provato:
  // rinominato `window.HirisRouter` da un lato solo, oxlint tace col cancello
  // come senza. Non e' un difetto da sanare qui: nessuna configurazione lo
  // sana. Quel lavoro lo fa `scripts/sponde_js.py`, che guarda i file
  // INSIEME, e i due si sorvegliano a vicenda -- la lista `globals` qui sotto
  // smette di essere una concessione al linter e diventa una dichiarazione
  // che qualcuno verifica.
  "env": { "browser": true, "es2021": true },

  // I 48 non sono scelti: sono i nomi che un file LEGGE senza dichiararli --
  // 25 namespace pubblicati su `window` e 23 nomi nudi di `common.js` (19
  // funzioni e quattro costanti: `SUBSCRIPTION_ONLY_COST_LABEL`, dal collaudo
  // 3.22 C5, letta da `config/usage-route.js`; `NOMI_REGISTRI`, letta da
  // `config/dashboard.js`; `SOGLIE_ATTESA` e `FRASI_ATTESA`, con
  // `stopwatchText`, lette dalla chat e dal «Rifalla» delle Proposte, attori
  // Task 4.4). Contati il 06/10/2026 dall'elenco qui sotto.
  //
  // `common.js` dichiara altri nomi nudi che NON stanno qui, ed e' deliberato
  // -- `_setUsageText`, `_showUsageRows`, `savedTheme`, `THEME_KEY`, le due
  // costanti anti-CSRF, e `paintSavedTheme` (la chiama solo lo script in
  // linea delle due pagine, che il linter non legge): nessun altro file
  // le legge, quindi restano sorvegliate dall'analisi di ambito. Aggiungerle
  // sarebbe un buco -- il giorno in cui qualcuno rinominasse la loro `function`
  // lasciando indietro la chiamata, `no-undef` tacerebbe perche' gliel'avremmo
  // detto noi che quel nome esiste. Un globale dichiarato senza bisogno non e'
  // prudenza, e' una rinuncia.
  //
  // QUATTRO ECCEZIONI DICHIARATE, dal 18/09/2026 (la pagina dell'osservatore in
  // sei file): `HirisWatcherGiorno`/`CosaFare`/`Sapere`/`Lavoro` non sono letti
  // nudi da nessuno -- il guscio li risolve per NOME (`window[scheda.modulo]`,
  // config/watcher-route.js) per poter dire «questa scheda non ha caricato»
  // invece di esplodere al montaggio. Stanno qui lo stesso, e non e' una
  // concessione al linter: e' il punto 1 di `scripts/sponde_js.py` -- un globale
  // dichiarato che nessun file di static/ produce piu' fa fallire il cancello,
  // ed e' l'UNICA cosa che vedrebbe una mezza rinomina di
  // `window.HirisWatcherGiorno`, che `no-undef` non puo' vedere per costruzione
  // (dall'altro lato c'e' una stringa). `HirisWatcherShared` invece e' letto
  // nudo dai cinque file che lo usano: per lui valgono tutti e tre i punti del
  // cancello, l'ordine dei `<script src>` compreso.
  "globals": {
    "HirisAgendaRoute": "readonly",
    "HirisBuildCheck": "readonly",
    "HirisChatAgents": "readonly",
    "HirisChatKeyboard": "readonly",
    "HirisChatMessages": "readonly",
    "HirisChatSend": "readonly",
    "HirisChatSidebar": "readonly",
    "HirisChatState": "readonly",
    "HirisChatTheme": "readonly",
    "HirisConstructions": "readonly",
    "HirisDashboard": "readonly",
    "HirisMemoryRoute": "readonly",
    "HirisModelsRoute": "readonly",
    "HirisRouter": "readonly",
    "HirisServicesRoute": "readonly",
    "HirisSettingsRoute": "readonly",
    "HirisState": "readonly",
    "HirisTreeRoute": "readonly",
    "HirisUsageRoute": "readonly",
    "HirisWatcherCosaFare": "readonly",
    "HirisWatcherGiorno": "readonly",
    "HirisWatcherLavoro": "readonly",
    "HirisWatcherRoute": "readonly",
    "HirisWatcherSapere": "readonly",
    "HirisWatcherShared": "readonly",
    "api": "readonly",
    "byId": "readonly",
    "clearEl": "readonly",
    "currentTheme": "readonly",
    "el": "readonly",
    "NOMI_REGISTRI": "readonly",
    "nomiRegistriInItaliano": "readonly",
    "pad2": "readonly",
    "renderError": "readonly",
    "setDisclosure": "readonly",
    "toggleTheme": "readonly",
    "applyTheme": "readonly",
    "configures": "readonly",
    "esc": "readonly",
    "fmtDateTime": "readonly",
    "fmtEuro": "readonly",
    "fmtNum": "readonly",
    "isSubscriptionOnly": "readonly",
    "loadUsage": "readonly",
    "SUBSCRIPTION_ONLY_COST_LABEL": "readonly",
    "SOGLIE_ATTESA": "readonly",
    "FRASI_ATTESA": "readonly",
    "stopwatchText": "readonly"
  },
  "rules": { "no-undef": "error" },
  "overrides": [
    {
      // La suite gira su Node e MONTA i globali del browser nel proprio realm
      // (vedi `tests/js/helpers/dom.mjs`): qui `process`/`global` esistono, e i
      // 48 si scrivono invece di leggersi soltanto.
      "files": ["tests/js/**"],
      "env": { "browser": true, "es2021": true, "node": true },
      "globals": {
        "HirisAgendaRoute": "writable",
        "HirisBuildCheck": "writable",
        "HirisChatAgents": "writable",
        "HirisChatKeyboard": "writable",
        "HirisChatMessages": "writable",
        "HirisChatSend": "writable",
        "HirisChatSidebar": "writable",
        "HirisChatState": "writable",
        "HirisChatTheme": "writable",
        "HirisConstructions": "writable",
        "HirisDashboard": "writable",
        "HirisMemoryRoute": "writable",
        "HirisModelsRoute": "writable",
        "HirisRouter": "writable",
        "HirisServicesRoute": "writable",
        "HirisSettingsRoute": "writable",
        "HirisState": "writable",
        "HirisTreeRoute": "writable",
        "HirisUsageRoute": "writable",
        "HirisWatcherCosaFare": "writable",
        "HirisWatcherGiorno": "writable",
        "HirisWatcherLavoro": "writable",
        "HirisWatcherRoute": "writable",
        "HirisWatcherSapere": "writable",
        "HirisWatcherShared": "writable",
        "api": "writable",
        "byId": "writable",
        "clearEl": "writable",
        "currentTheme": "writable",
        "el": "writable",
        "NOMI_REGISTRI": "writable",
        "nomiRegistriInItaliano": "writable",
        "pad2": "writable",
        "renderError": "writable",
        "setDisclosure": "writable",
        "toggleTheme": "writable",
        "applyTheme": "writable",
        "configures": "writable",
        "esc": "writable",
        "fmtDateTime": "writable",
        "fmtEuro": "writable",
        "fmtNum": "writable",
        "isSubscriptionOnly": "writable",
        "loadUsage": "writable",
        "SUBSCRIPTION_ONLY_COST_LABEL": "writable"
      }
    }
  ]
}
